# ─────────────────────────────────────────────────────────────
# DevMaster Hub — mẫu biến môi trường
# Sao chép file này thành .env rồi điền khóa thật vào.
# TUYỆT ĐỐI không commit file .env lên git (đã có trong .gitignore).
# ─────────────────────────────────────────────────────────────

# ── Nhà cung cấp AI ──
# Server thử lần lượt theo thứ tự dưới đây, cái nào lỗi thì tự chuyển sang cái kế tiếp.
# Chỉ cần MỘT khóa là chạy được. OPENROUTER_API_KEY là lựa chọn tốt nhất vì
# một khóa duy nhất dùng được cả Gemini, DeepSeek lẫn Claude.

OPENROUTER_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
CLAUDE_API_KEY=

# ── Tìm việc làm ──
# Khóa JSearch trên RapidAPI. Bỏ trống thì server tự dùng Remotive + Arbeitnow (miễn phí, không cần khóa).
JSEARCH_API_KEY=

# ── Supabase (đăng nhập và lưu tiến độ học) ──
# Hai giá trị này là công khai — chúng cũng nằm trong public/auth-service.js.
# Bảo mật do Row Level Security ở phía Supabase đảm nhiệm, không phải do giấu khóa.
# Server dùng chúng để xác thực token của người dùng trước khi cho gọi API tốn tiền.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=

# ── Cấu hình chạy ──
# BASE_URL phải là domain thật khi deploy — nó được dùng để sinh canonical URL,
# thẻ og:* và sitemap.xml. Điền sai là Google đánh giá SEO sai.
BASE_URL=https://devmaster-hub.onrender.com
PORT=3000
